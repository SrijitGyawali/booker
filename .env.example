# =============================================================================
# booker configuration
# -----------------------------------------------------------------------------
#   1. Copy it:      cp .env.example .env
#   2. Fill in .env. It is git-ignored and must never be committed.
#   3. Every new config key is added HERE too, with an EMPTY value.
#
# Real secrets live only in .env locally and in the hosting platform's secret
# store in production. Never in git, never baked into a Docker image.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | production
APP_ENV=
# Port the HTTP API listens on, e.g. 8080
PORT=

# --- PostgreSQL --------------------------------------------------------------
# Empty values fall back to the docker-compose defaults: booker / booker / 5432
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=
# Required. Letters and digits only, so it can go straight into DATABASE_URL
# (generate one with: openssl rand -hex 24)
POSTGRES_PASSWORD=
# Used by the API from Day 9. Local format:
#   postgres://<user>:<password>@localhost:<port>/<db>?sslmode=disable
DATABASE_URL=

# --- Redis -------------------------------------------------------------------
# Empty falls back to the docker-compose default: 6379
REDIS_PORT=
# Required (generate one with: openssl rand -hex 24)
REDIS_PASSWORD=
# Used by the API from Day 31. Local format:
#   redis://:<password>@localhost:<port>/0
REDIS_URL=

# --- Authentication (Phase 4) ------------------------------------------------
# Signing key for access tokens, Day 22 (generate with: openssl rand -base64 48)
JWT_SECRET=
# "Login with Google" OAuth client, Day 26
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
