# EditorConfig keeps whitespace identical across editors: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go source and go.mod use tabs (gofmt enforces it for .go files anyway)
[{*.go,go.mod,go.work}]
indent_style = tab
indent_size = 4

# make requires a tab before every recipe line
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Two trailing spaces are a hard line break in Markdown
[*.md]
trim_trailing_whitespace = false
